{
  "name": "phu-de-hop",
  "productName": "Phu de hop",
  "version": "0.1.0",
  "description": "Phụ đề dịch realtime cho cuộc họp, dùng key Google Cloud của chính bạn.",
  "main": "src/main/main.js",
  "license": "MIT",
  "author": {
    "name": "your-org",
    "email": "your-email@example.com"
  },
  "homepage": "https://github.com/your-org/phu-de-hop",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/phu-de-hop.git"
  },
  "scripts": {
    "start": "electron .",
    "start:mac": "open -W -n node_modules/electron/dist/Electron.app --args \"$PWD\"",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "io.github.your-org.phudehop",
    "productName": "Phu de hop",
    "artifactName": "phu-de-hop-${version}-${os}-${arch}.${ext}",
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "your-org",
        "repo": "phu-de-hop"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Phu de hop cần micro để nhận dạng giọng nói và hiện phụ đề.",
        "NSAudioCaptureUsageDescription": "Phu de hop cần thu âm thanh máy tính để hiện phụ đề cho cuộc họp.",
        "NSScreenCaptureUsageDescription": "Phu de hop cần quyền ghi màn hình và âm thanh hệ thống để thu âm thanh cuộc họp (không lưu hình ảnh)."
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "maintainer": "your-org <your-email@example.com>"
    }
  },
  "dependencies": {
    "@google-cloud/speech": "^8.1.0",
    "@google-cloud/translate": "^10.1.0"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  }
}
